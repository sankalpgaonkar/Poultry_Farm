# Copy this file to .env and fill in the values in [BRACKETS].
# Never commit .env. On Vercel/Render, set these in the dashboard instead.

# ---------- Server ----------
NODE_ENV=development
PORT=5005

# MongoDB connection string (MongoDB Atlas -> Connect -> Drivers), e.g.
# mongodb+srv://<user>:<password>@<cluster>.mongodb.net/poultrysmart?retryWrites=true&w=majority
MONGODB_URI=[DATABASE_URL]

# Long random string used to sign login tokens (at least 32 characters). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=[JWT_SECRET]
# How long a login lasts (e.g. 7d, 12h)
JWT_EXPIRES_IN=7d

# Comma-separated list of websites allowed to call the API from a browser.
# Only needed when the frontend is on a different domain from the API.
CLIENT_ORIGIN=http://localhost:5173

# Optional: Google Gemini key for the Kisan Mitra assistant, bill-photo scanning and smart alerts.
# Without it the app still works; AI features show an "offline" message.
GEMINI_API_KEY=[API_KEY]
GEMINI_MODEL=gemini-2.5-flash

# Render "single service" mode: Express also serves the built frontend from /dist.
SERVE_FRONTEND=false

# ---------- Frontend (read at build time) ----------
# Leave empty when the frontend and API are on the same domain (Vercel, Render single service).
# Set to the API's URL (no trailing slash) when they are separate, e.g. https://poultrysmart-api.onrender.com
VITE_API_URL=

# Demo mode: shows "Try demo as Farmer / Buyer / Admin" on the login page and "Try the live demo" on the home page.
# Defaults to true (for the interview/demo deploy). Set to false for a real customer launch.
# The demo accounts exist only after you run:  MONGODB_URI=... npm run seed:demo
VITE_DEMO_MODE=true
