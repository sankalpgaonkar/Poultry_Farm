{
  "name": "poultrysmart",
  "version": "2.0.0",
  "private": true,
  "description": "PoultrySmart: farm management, marketplace and AI assistant for poultry farmers",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c green,cyan \"nodemon --watch backend backend/server.js\" \"vite\"",
    "dev:api": "nodemon --watch backend backend/server.js",
    "dev:web": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node backend/server.js",
    "test": "node --test --test-concurrency=1 backend/tests/*.test.js",
    "lint": "eslint .",
    "seed": "node backend/scripts/seed.js",
    "check": "npm run lint && npm test && npm run build",
    "seed:demo": "node backend/scripts/seedDemo.js"
  },
  "dependencies": {
    "@google/genai": "^1.48.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.6.1",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^8.23.0",
    "multer": "^2.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@fontsource-variable/outfit": "^5.3.0",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "axios": "^1.7.9",
    "concurrently": "^9.1.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "framer-motion": "^14.7.1",
    "globals": "^17.13.0",
    "lucide-react": "^0.475.0",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.9",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.2.0",
    "recharts": "^2.15.1",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.0.0",
    "three": "^0.186.1",
    "vite": "^6.1.1"
  },
  "config": {
    "mongodbMemoryServer": {
      "disablePostinstall": "1"
    }
  },
  "overrides": {
    "qs": "^6.16.2"
  }
}
